{
  "functions": {
    "api/graph.js": {
      "maxDuration": 10
    },
    "api/worklog.js": {
      "maxDuration": 30
    },
    "api/repo-sync.js": {
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ]
}
